# Server Port
PORT=5000
NODE_ENV=development

# Database Configuration (Optional - falls back to local in-memory/JSON storage if not set)
MONGODB_URI=mongodb://localhost:27017/voxcoach

# Security
JWT_SECRET=voxcoach_super_secret_jwt_key_2025_learning_platform
JWT_EXPIRES_IN=7d

# AI Service (Google Gemini API Key)
# If empty, server seamlessly operates in realistic developmental Mock AI mode
GEMINI_API_KEY=

# Speech To Text Service (Optional - falls back to Web Speech / Built-in Whisper / Gemini Audio)
STT_PROVIDER=gemini
